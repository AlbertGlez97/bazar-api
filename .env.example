# Local examples only. Replace passwords and matching URL components together.
# HTTP port the Nest app listens on. Defaults to 3000 when unset.
PORT=3000
POSTGRES_USER=bazar_dev
POSTGRES_PASSWORD=replace_dev_password
POSTGRES_DB=bazar_dev
POSTGRES_PORT=5432
POSTGRES_TEST_USER=bazar_test
POSTGRES_TEST_PASSWORD=replace_test_password
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://bazar_dev:replace_dev_password@127.0.0.1:5432/bazar_dev
DATABASE_URL_TEST=postgresql://bazar_test:replace_test_password@127.0.0.1:5433/bazar_test
# Generate JWT_SECRET independently (at least 32 random characters).
JWT_SECRET=
# Provision a local account explicitly; never commit the real seed password.
# SEED_CONTEXT_ID (BE-11): only the contextId prisma/seed.ts uses for its
# single example business (Alberto/Adid) in local dev/tests — the system
# itself supports any number of independent contextIds/businesses, created
# either by re-running the seed with a different value or via the
# business-registration approval flow (see doc/reglas-de-negocio.md).
SEED_CONTEXT_ID=bazar-local
SEED_USERNAME=
SEED_PASSWORD=
# API docs (Swagger UI at /docs) are OFF unless this is exactly "true".
# Recommended: leave false or absent in production unless briefly needed.
ENABLE_API_DOCS=false
# HTTP Basic Auth credentials guarding /docs. Independent from JWT/socio
# credentials; required only when ENABLE_API_DOCS=true.
DOCS_USER=
DOCS_PASSWORD=
# Local disk directory where product images are stored (BE-04). Defaults to
# uploads/products (relative to the process cwd) when unset; only needs a
# value if you want images written somewhere else on this machine.
PRODUCT_UPLOAD_DIR=
# Resend (BE-11): sends the business-registration approval email. The API
# key is per-account; onboarding@resend.dev (a Resend-provided test sender)
# is used as the "from" address for now, so no separate sender variable is
# needed yet.
RESEND_API_KEY=
# Fixed recipient (BE-11) who receives every "new business registration"
# approval email; currently a single person (albert.gonzalez0297@gmail.com),
# kept as a variable rather than hardcoded so it can change without a code
# change.
APPROVAL_NOTIFICATION_EMAIL=
# Base URL (BE-11) used to build the approve/reject links embedded in the
# registration email; e.g. https://api.example.com. Defaults to
# http://localhost:$PORT when unset, which only makes sense in local dev.
APP_BASE_URL=
# NODE_ENV is set to test by test tooling; no application setting is required.
