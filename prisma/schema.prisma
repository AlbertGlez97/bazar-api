generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  unica
  cantidad
}

enum MemberRole {
  socio
  colaborador
}

enum SaleStatus {
  completada
  rechazada_por_conflicto
}

enum IncidenciaType {
  conflicto_stock
  incidencia_fecha
}

enum IncidenciaResolutionStatus {
  pendiente
  resuelta
}

enum DeudaType {
  fiado
  apartado
}

enum DeudaStatus {
  pendiente
  saldada
}

enum BusinessRegistrationStatus {
  // Email verification (registration v2): the person has not confirmed the link yet.
  // NOTHING reaches the approver in this state.
  pendiente_correo
  pendiente
  aprobado
  rechazado
}

// What the business sells, as picked in the registration form (Spanish labels live in
// src/business-registration/business-type.ts).
enum BusinessType {
  bazar_o_tianguis
  abarrotes
  ropa_y_accesorios
  comida_y_bebidas
  plantas_y_jardineria
  artesanias
  servicios
  otro
}

// BE-12: lifecycle of a Device. `pendiente_activacion` = registered by a
// socio, waiting for someone to redeem its one-time identifier;
// `activo` = in use; `revocado` = switched off. Devices that exist before
// BE-12 are `activo` (or `revocado` when they were unauthorized). The
// `authorized` boolean below stays the operating gate read by the guards;
// the code that changes `status` keeps the two in sync.
enum DeviceStatus {
  pendiente_activacion
  activo
  revocado
}

model Account {
  proposedFinanceRuleSets        FinanceRuleSet[]
  financeRuleApprovals           FinanceRuleApproval[]
  invitationsUsed                AccountInvitation[]
  recordedDistributionAgreements DistributionAgreement[]
  distributionAgreementReversals DistributionAgreementReversal[]
  recordedDistributionPayments   DistributionPayment[]
  distributionPaymentReversals   DistributionPaymentReversal[]
  recordedFinanceReserves        FinanceReserve[]
  financeReserveReversals        FinanceReserveReversal[]
  recordedWorkShifts             WorkShift[]
  workShiftReversals             WorkShiftReversal[]
  id                             String                          @id @default(uuid()) @db.Uuid
  username                       String                          @unique
  passwordHash                   String
  contextId                      String
  active                         Boolean                         @default(true)
  createdAt                      DateTime                        @default(now()) @db.Timestamptz(3)
  // BE-12: the Member this login belongs to. Null = the shared login of a
  // business (every account that exists before BE-12, including the founding
  // socio's): whoever holds it may pick any active Member with x-member-id,
  // which is the shared-tablet flow. Set = the account is bound to exactly
  // that Member and ContextGuard must refuse any other x-member-id, so a
  // colaborador's own login cannot act as a socio. Unique: one login per
  // Member.
  //
  // ON DELETE RESTRICT (not SET NULL): if the Member row were ever hard
  // deleted, SET NULL would silently turn a bound colaborador login into an
  // unbound shared one that may select any Member, including a socio. Members
  // are only ever deactivated (BE-10), so nothing legitimate needs the delete.
  memberId                       String?                         @unique @db.Uuid
  member                         Member?                         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([id, contextId])
}

model Member {
  proposedFinanceRuleSets             FinanceRuleSet[]
  financeRuleApprovals                FinanceRuleApproval[]
  financeRuleRemindersReceived        FinanceRuleReminder[]              @relation("RuleReminderTarget")
  financeRuleRemindersSent            FinanceRuleReminder[]              @relation("RuleReminderSender")
  accountInvitations                  AccountInvitation[]                @relation("InvitationTarget")
  accountInvitationsSent              AccountInvitation[]                @relation("InvitationSender")
  recordedDistributionAgreements      DistributionAgreement[]
  distributionAgreementReversals      DistributionAgreementReversal[]
  distributionAgreementParticipations DistributionAgreementParticipant[]
  recordedDistributionPayments        DistributionPayment[]
  distributionPaymentReversals        DistributionPaymentReversal[]
  recordedFinanceReserves             FinanceReserve[]
  financeReserveReversals             FinanceReserveReversal[]
  id                                  String                             @id @default(uuid()) @db.Uuid
  name                                String
  role                                MemberRole                         @default(colaborador)
  contextId                           String                             @default("legacy-unassigned")
  createdAt                           DateTime                           @default(now()) @db.Timestamptz(3)
  // Soft delete (BE-10): a deactivated colaborador cannot be selected as
  // the acting member (ContextGuard) and disappears from the default
  // GET /members listing, but every historical row still referencing this
  // Member (Sale, ProductAudit, Incidencia, Deuda, Abono, Commission
  // calculation) remains fully intact and queryable. A socio can never be
  // deactivated through this mechanism (enforced in MembersService, not
  // here) — socios are owners, not removable staff.
  active                              Boolean                            @default(true)
  contributions                       Contribution[]                     @relation("ContributionMember")
  recordedContributions               Contribution[]                     @relation("ContributionRecorder")
  contributionReversals               ContributionReversal[]
  paidExpenses                        Expense[]                          @relation("ExpensePayer")
  recordedExpenses                    Expense[]                          @relation("ExpenseRecorder")
  expenseReversals                    ExpenseReversal[]
  stockMovements                      StockMovement[]
  workShifts                          WorkShift[]                        @relation("WorkShiftWorker")
  recordedWorkShifts                  WorkShift[]                        @relation("WorkShiftRecorder")
  workShiftReversals                  WorkShiftReversal[]
  sales                               Sale[]
  productAudits                       ProductAudit[]
  // Only ever populated for a Member whose role is "socio" (enforced in
  // IncidenciasService, not at the schema level): colaboradores never
  // resolve incidencias.
  resolvedIncidencias                 Incidencia[]
  // Individual commission percentage override, expressed in basis points
  // (1 bp = 0.01%, so 1000 = 10.00%) rather than a Decimal, matching the
  // rest of the project's convention of using integers for anything
  // money/percentage-related to avoid floating-point drift. Null means
  // "no override" — CommissionsService falls back to
  // AppSettings.defaultCommissionRateBps. Meaningful only for
  // role="colaborador" (enforced in CommissionsService, not here); a
  // socio is never paid a sales commission.
  commissionRateBps                   Int?
  // A socio's authorization to create a Deuda (fiado/apartado); a
  // colaborador may still *receive* an abono against one (see
  // Abono.receivedByMember) without ever appearing here.
  deudasCreadas                       Deuda[]                            @relation("DeudaCreatedBy")
  abonosRecibidos                     Abono[]                            @relation("AbonoReceivedBy")
  // BE-12: the login bound to this Member, when it has its own (created by
  // POST /members). Null for members that share the business login.
  account                             Account?
  // BE-12: which Member (a socio) added this one. Null for the founding socio,
  // the seed and every row that existed before BE-12. ON DELETE SET NULL:
  // this is attribution, not integrity, and Members are only ever
  // deactivated, so a hard delete of the creator must not be blocked (or
  // fail a bulk delete of both rows) just to keep a pointer.
  createdByMemberId                   String?                            @db.Uuid
  createdByMember                     Member?                            @relation("MemberCreatedBy", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdMembers                      Member[]                           @relation("MemberCreatedBy")

  @@unique([id, contextId])
  @@index([createdByMemberId])
}

model Device {
  recordedDistributionAgreements DistributionAgreement[]
  distributionAgreementReversals DistributionAgreementReversal[]
  recordedDistributionPayments   DistributionPayment[]
  distributionPaymentReversals   DistributionPaymentReversal[]
  recordedFinanceReserves        FinanceReserve[]
  financeReserveReversals        FinanceReserveReversal[]
  id                             String                          @id @default(uuid()) @db.Uuid
  name                           String
  // BE-12: for a device registered through POST /devices this is the
  // ONE-TIME activation code (uuid v7): it is redeemed once at
  // POST /devices/identify and is dead afterwards. It is not a credential.
  // Devices that predate BE-12 keep the value they already have.
  identifier                     String                          @unique @default(uuid())
  contextId                      String                          @default("legacy-unassigned")
  authorized                     Boolean                         @default(false)
  createdAt                      DateTime                        @default(now()) @db.Timestamptz(3)
  // BE-12: see DeviceStatus. Default `activo` so every device created by the
  // seed, by business approval and by the existing test fixtures stays usable.
  status                         DeviceStatus                    @default(activo)
  // BE-12: sha256 (hex) of the device token issued at activation. Null =
  // legacy device: it authenticates with x-device-id alone, exactly as before
  // BE-12. Set = requests must also carry the matching x-device-token. The
  // token itself is never stored.
  tokenHash                      String?
  activatedAt                    DateTime?                       @db.Timestamptz(3)
  revokedAt                      DateTime?                       @db.Timestamptz(3)
  contributions                  Contribution[]
  contributionReversals          ContributionReversal[]
  expenses                       Expense[]
  expenseReversals               ExpenseReversal[]
  workShifts                     WorkShift[]
  workShiftReversals             WorkShiftReversal[]
  sales                          Sale[]

  @@unique([id, contextId])
}

model Product {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  tipo              ProductType
  unitPriceMinor    Int
  contextId         String          @default("legacy-unassigned")
  imagePath         String?
  initialStock      Int
  stock             Int
  category          String?
  purchaseCostMinor Int?
  supplier          String?
  notes             String?
  // Optional descriptors that help to tell look-alike products apart and to
  // show a product's sheet when its QR is scanned. All NULL on existing rows.
  // brand <= 40, presentation <= 40 (size/measure/capacity; the color goes
  // inside, "Azul · 28"), description <= 200: enforced by the DTOs.
  brand             String?
  presentation      String?
  description       String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  // Soft delete (BE-10): a deactivated product disappears from the
  // default catalog listing and cannot be sold or fiado/apartado'd even
  // if it still has stock > 0, but the row itself (and every historical
  // reference to it — SaleItem, ProductAudit, Deuda) is preserved rather
  // than deleted, so past sales/audits/deudas keep working exactly as
  // before deactivation.
  active            Boolean         @default(true)
  saleItems         SaleItem[]
  audits            ProductAudit[]
  stockMovements    StockMovement[]
  deudas            Deuda[]

  @@index([contextId, createdAt, id])
}

// How a sale or an abono was paid. Spanish upper case, like StockMovementType.
// Only the means is recorded (no receipt number or terminal reference); it
// never changes stock or a debt's balance. Existing rows are EFECTIVO.
enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum StockMovementType {
  // Only restocking exists today. Kept as an enum (not a boolean/free text)
  // so a later "Corregir existencia" (set the stock to a counted value) can
  // be added as another value without reshaping the table.
  REPOSICION
}

// Append-only fact: one row per change a socio makes to a product's stock
// outside of sales/deudas ("who added how many pieces, when, from what to
// what"). Never updated or deleted — the runtime role only gets INSERT and
// SELECT on it (scripts/provision-app-role.mjs). Sales and deudas, which
// decrement stock, do not write here.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  contextId     String
  productId     String            @db.Uuid
  memberId      String            @db.Uuid
  type          StockMovementType
  // Pieces added (> 0); stockAfter - stockBefore always equals it.
  quantity      Int
  stockBefore   Int
  stockAfter    Int
  // Unit cost of this purchase in cents; null when the socio left it empty.
  unitCostMinor Int?
  note          String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  product       Product           @relation(fields: [productId], references: [id])
  member        Member            @relation(fields: [memberId], references: [id])

  @@index([contextId, productId, createdAt, id])
}

model ProductAudit {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @db.Uuid
  memberId          String   @db.Uuid
  // BE-11: direct contextId (not just reachable via `product`/`member`),
  // matching every other tenant-scoped model — required by the Prisma
  // Client Extension (which filters/injects on a model's own column, not
  // a relation hop) and by the Postgres RLS policy on this table.
  contextId         String   @default("legacy-unassigned")
  changedAt         DateTime @default(now()) @db.Timestamptz(3)
  oldUnitPriceMinor Int?
  newUnitPriceMinor Int
  before            Json?
  after             Json
  product           Product  @relation(fields: [productId], references: [id])
  member            Member   @relation(fields: [memberId], references: [id])

  @@index([productId, changedAt, id])
  @@index([contextId])
}

model Sale {
  // Client-generated stable identity; primary key enforces uniqueness.
  id                 String        @id @db.Uuid
  memberId           String        @db.Uuid
  deviceId           String        @db.Uuid
  // BE-11: direct contextId, denormalized from member/device (which must
  // already agree — see SalesService.authorize) so this table can be
  // filtered/RLS-protected on its own column instead of only reachable
  // via a join through Member.
  contextId          String        @default("legacy-unassigned")
  occurredAt         DateTime      @db.Timestamptz(3)
  receivedAt         DateTime      @default(now()) @db.Timestamptz(3)
  currency           String        @default("MXN") @db.Char(3)
  // "completada" is the only status BE-05 ever produced; BE-06 adds
  // "rechazada_por_conflicto" for sales that lost a real stock race
  // between offline sales synchronizing concurrently (see SalesService).
  status             SaleStatus    @default(completada)
  // Null only for a "rechazada_por_conflicto" sale: the total/change could
  // not be (and is not) computed once processing is aborted mid-sale, so
  // these are never a stand-in for zero.
  totalMinor         Int?
  paymentMethod      PaymentMethod @default(EFECTIVO)
  // Cash handed over. Null when the sale was paid by TRANSFERENCIA/TARJETA
  // (the full total is charged; "not applicable", never a stand-in for 0 —
  // enforced by the Sale_noncash_has_no_cash CHECK). Always set for EFECTIVO.
  cashReceivedMinor  Int?
  // Normalized request identity, including attempted items for rejected sales.
  requestFingerprint String?
  changeMinor        Int?
  // Populated only when status = rechazada_por_conflicto; explains which
  // product lost the race and when the conflict was detected, for manual
  // review — there is no automatic resolution.
  conflictReason     String?
  conflictDetectedAt DateTime?     @db.Timestamptz(3)
  member             Member        @relation(fields: [memberId], references: [id])
  device             Device        @relation(fields: [deviceId], references: [id])
  items              SaleItem[]
  // Since BE-07, both a "conflicto_stock" and an "incidencia_fecha" also
  // create an Incidencia row (see Incidencia model); `status` is kept as
  // the cheap/fast filter for "did this sale apply to inventory", while
  // Incidencia carries the richer, independently-resolvable review
  // workflow. A sale can have more than one Incidencia (e.g. a stock
  // conflict *and* an out-of-range occurredAt on the same attempt).
  incidencias        Incidencia[]

  @@index([status, receivedAt, id])
  @@index([contextId])
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @db.Uuid
  productId      String   @db.Uuid
  // BE-11: denormalized from the parent Sale, set explicitly by
  // SalesService when constructing the nested `items: { create: [...] } }`
  // payload — a Prisma Client Extension only intercepts a model's own
  // top-level operation, not a nested relation write buried inside a
  // different model's `create`, so this one column cannot rely on the
  // extension and is filled in by hand at every call site instead.
  contextId      String   @default("legacy-unassigned")
  quantity       Int
  unitPriceMinor Int
  subtotalMinor  Int
  // BE-13: snapshot of Product.purchaseCostMinor at the moment of the sale,
  // never recomputed later. Nullable on purpose: every sale made before this
  // column existed, and every sale of a product that still has no cost
  // captured, stays null forever — profit for that line is "not available",
  // never estimated or treated as zero. Changing a product's cost afterward
  // must never rewrite what a past sale actually cost at the time.
  unitCostMinor  Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  sale           Sale     @relation(fields: [saleId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@index([contextId])
}

// A standing, independently-resolvable record of something that needed a
// human's attention while registering a sale — a lost stock race between
// offline sales synchronizing concurrently ("conflicto_stock"), or an
// occurredAt outside the plausible clock-skew/offline-queue window
// ("incidencia_fecha"). Deliberately its own table rather than only a
// Sale.status value: a Sale is either applied to inventory or it isn't,
// but an Incidencia has its own lifecycle (pendiente -> resuelta) that a
// socio works through independently, days after the sale itself is done.
model Incidencia {
  id                 String                     @id @default(uuid()) @db.Uuid
  saleId             String                     @db.Uuid
  // BE-11: same rationale as SaleItem.contextId — set by hand wherever an
  // Incidencia is created nested under `Sale.create`, since a Prisma
  // Client Extension cannot see inside another model's nested write.
  contextId          String                     @default("legacy-unassigned")
  type               IncidenciaType
  reason             String
  detectedAt         DateTime                   @default(now()) @db.Timestamptz(3)
  // "pendiente" until a socio explicitly resolves it; there is no automatic
  // resolution (refund, re-stocking, reassigning stock, correcting the
  // date) — that is always a human decision made with the customer.
  resolutionStatus   IncidenciaResolutionStatus @default(pendiente)
  resolvedByMemberId String?                    @db.Uuid
  resolvedAt         DateTime?                  @db.Timestamptz(3)
  resolutionNotes    String?
  sale               Sale                       @relation(fields: [saleId], references: [id])
  resolvedBy         Member?                    @relation(fields: [resolvedByMemberId], references: [id])

  @@index([resolutionStatus, detectedAt, id])
  @@index([contextId])
}

// A single settings row per context (contextId as primary key, not a
// synthetic id), matching every other model's context-scoping convention
// rather than being a truly global singleton across the whole database —
// each bazar "context" (a distinct authorized deployment/tenant, and in
// tests, a distinct throwaway fixture) configures its own default
// commission percentage independently. Modeled as one purpose-built table
// (not a generic key-value Setting store) because there is exactly one
// setting to hold today; a key-value table would only add indirection
// (string-keyed, stringly-typed values) for no present benefit.
model AppSettings {
  contextId                String   @id
  // Basis points (1 bp = 0.01%; 1000 = 10.00%), same integer convention as
  // Member.commissionRateBps. Applies to every colaborador in this context
  // that has no individual commissionRateBps override. Defaults to 0
  // (no commission) rather than some non-zero placeholder, so a context
  // that never explicitly configures this does not silently start owing
  // commissions on every sale.
  defaultCommissionRateBps Int      @default(0)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
}

// An informal debtor record — just enough to know who owes what, not a
// full customer/identity system. No context-transitive relation exists
// (unlike Incidencia -> Sale -> Member), since a Deudor is not "owned" by
// any single Member, so it is scoped directly by contextId like
// Product/Member/Device, rather than only being reachable through a Deuda.
model Deudor {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  telefono  String?
  notas     String?
  contextId String   @default("legacy-unassigned")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  deudas    Deuda[]

  @@index([contextId, nombre])
}

// Unifies "fiado" (the product already left the bazar with the customer)
// and "apartado" (the product is being held for the customer) under one
// concept: from an inventory standpoint both are identical — the piece is
// no longer available for sale to anyone else — and both are settled the
// same way (abonos against a running balance), so a separate model per
// type would only duplicate the abono/balance machinery for no behavioral
// difference. `type` is kept purely as a label for the socio's own
// bookkeeping (e.g. "should I still be holding this apartado, or did it
// already leave as a fiado").
//
// Deliberately single-product (`productId`/`cantidad`), not a `DeudaItem[]`
// like Sale/SaleItem: the task that introduced this model specified these
// exact scalar fields (not a line-items array), and in practice an
// informal fiado/apartado is negotiated per-piece with a customer, not as
// a shopping-cart checkout. A customer wanting credit on several distinct
// products at once is expected to be represented as multiple Deuda rows
// today; graduating to a multi-item Deuda (mirroring SaleItem) is left as
// a future entry if that assumption turns out to be wrong in practice.
model Deuda {
  id                 String          @id @default(uuid()) @db.Uuid
  // Immutable creation receipt; nullable for historical/server-ID clients.
  requestFingerprint String?
  creationResponse   Json?
  type               DeudaType
  deudorId           String          @db.Uuid
  productId          String          @db.Uuid
  // BE-11: direct contextId (previously only reachable via
  // `createdByMember.contextId`), required by the extension/RLS.
  contextId          String          @default("legacy-unassigned")
  cantidad           Int
  totalMinor         Int
  // Never set directly through the API — always derived from the sum of
  // this Deuda's abonos inside the same transaction that inserts an
  // Abono (see DeudasService.registerAbono), so it can never drift from
  // reality or be overwritten by mistake.
  status             DeudaStatus     @default(pendiente)
  // BE-15 (D5): snapshot of Product.purchaseCostMinor taken at creation,
  // same nullable, never-estimated/never-recomputed pattern as
  // SaleItem.unitCostMinor (BE-13) — null stays null forever (no
  // backfill, no guessing), and changing the product's cost later never
  // rewrites what a past Deuda actually cost at the time. Needed so
  // "deudas liquidadas" reporting (D7) can compute real profit.
  unitCostMinor      Int?
  // BE-15 (D4): set exactly once, inside registerAbono's existing
  // transaction, at the precise moment `status` flips to "saldada" —
  // never set any other way, never backfilled for rows that were already
  // saldada before this column existed (those stay null: we genuinely
  // don't know when they settled).
  saldadaAt          DateTime?       @db.Timestamptz(3)
  createdByMemberId  String          @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  deudor             Deudor          @relation(fields: [deudorId], references: [id])
  product            Product         @relation(fields: [productId], references: [id])
  createdByMember    Member          @relation("DeudaCreatedBy", fields: [createdByMemberId], references: [id])
  abonos             Abono[]
  // BE-15 (D2): purely informative payment schedule, never read by any
  // balance calculation (see CuotaPlaneada's own doc comment).
  cuotasPlaneadas    CuotaPlaneada[]

  @@index([status, createdAt, id])
  @@index([contextId])
}

model Abono {
  id                 String        @id @default(uuid()) @db.Uuid
  deudaId            String        @db.Uuid
  // BE-11: direct contextId (previously only reachable via
  // `deuda.createdByMember.contextId`), required by the extension/RLS.
  contextId          String        @default("legacy-unassigned")
  montoMinor         Int
  receivedByMemberId String        @db.Uuid
  receivedAt         DateTime      @default(now()) @db.Timestamptz(3)
  nota               String?
  // How this abono was paid. Never edited afterwards and never part of the
  // balance calculation.
  paymentMethod      PaymentMethod @default(EFECTIVO)
  deuda              Deuda         @relation(fields: [deudaId], references: [id])
  receivedByMember   Member        @relation("AbonoReceivedBy", fields: [receivedByMemberId], references: [id])

  @@index([deudaId, receivedAt, id])
  @@index([contextId])
}

// BE-15 (D2): a purely informative payment schedule for a Deuda —
// "when the debtor said they'd pay each installment", not a ledger of what
// actually happened. NEVER read by DeudasService.registerAbono or any other
// balance/status calculation: the running balance is, and remains, always
// and only the sum of real Abono rows (see Abono's own doc comment on
// DeudasService.registerAbono) — a CuotaPlaneada existing, matching or not
// matching any real payment never moves the saldo, never flips `status`,
// and is never itself an Abono. Tenant-scoped like every sibling model
// (contextId + mirrored RLS policy, see doc/reglas-de-negocio.md's
// "Multi-tenancy (BE-11)" section for the pattern this follows).
model CuotaPlaneada {
  id                 String   @id @default(uuid()) @db.Uuid
  deudaId            String   @db.Uuid
  contextId          String   @default("legacy-unassigned")
  // Calendar day, not an instant. Prisma exposes DATE as UTC midnight.
  fechaEsperada      DateTime @db.Date
  montoEsperadoMinor Int
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  deuda              Deuda    @relation(fields: [deudaId], references: [id])

  @@index([deudaId, fechaEsperada])
  @@index([contextId])
}

// BE-11 part 2: a prospective new tenant's registration form, prior to
// having any operative contextId at all. Deliberately NOT tenant-scoped
// (no contextId column, never touched by the Prisma tenant-isolation
// extension) — it exists *before* any tenant does, and a rejected/still-
// pending request never becomes one, so scoping it by a contextId that
// may not (yet, or ever) exist would be backwards. `createdContextId` is
// only ever populated once, at approval time, as a forward pointer to the
// tenant this request produced — it is record-keeping, not a scope.
model BusinessRegistrationRequest {
  id                String                     @id @default(uuid()) @db.Uuid
  nombreNegocio     String
  // The founding socio's first name(s) and last name(s), and how to reach
  // them. `correo` is a verified-deliverable, trimmed, lower-cased email (the
  // credentials go there); it is the empty string only for rows created
  // before this split, whose free-text contact was not an email (they keep
  // working through the "relay through the approver" path). `apellidos` is
  // likewise '' for those legacy rows.
  nombre            String
  apellidos         String
  correo            String
  telefono          String?
  status            BusinessRegistrationStatus @default(pendiente)
  // Hashed (sha256) the same way a password would be, never the raw
  // token: the value that actually authorizes approving/rejecting a
  // registration is exactly as sensitive as a credential, and it travels
  // over email (a channel this system does not control end-to-end), so a
  // leaked/misdelivered email must not, by itself, hand over a usable
  // secret straight from a database dump either.
  approvalTokenHash String
  tokenExpiresAt    DateTime                   @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  // Set the first time the token is successfully consumed (approve or
  // reject) — the actual one-use enforcement is "status is no longer
  // pendiente", not this field, but it is kept for an admin-facing
  // "when was this resolved" answer alongside status.
  resolvedAt        DateTime?                  @db.Timestamptz(3)
  createdContextId  String?

  // ── Registration v2 (email verification). Every column below is NULL (or its default)
  // on rows that existed before, so those rows keep their meaning untouched. ──
  tipoNegocio             BusinessType?
  // Free text typed by the applicant: UNTRUSTED. Always HTML-escaped when shown.
  queVende                String?
  dondeVende              String?
  recomendadoPor          String?
  // Version (YYYY-MM-DD) of the privacy notice + terms accepted, and when (server clock).
  legalVersion            String?
  legalAcceptedAt         DateTime?     @db.Timestamptz(3)
  // Set when the applicant opens the emailed link and confirms. Until then the request is
  // "pendiente_correo" and the approver has not been told about it.
  emailVerifiedAt         DateTime?     @db.Timestamptz(3)
  // sha256 of the one-use verification token (32 random bytes, never stored raw); cleared
  // on use. Expires 48 h after it is issued.
  emailTokenHash          String?
  emailTokenExpiresAt     DateTime?     @db.Timestamptz(3)
  // Verification emails sent for this request and when the last one went out (resend rules:
  // 60 s apart, at most 3 in total).
  verificationEmailsSent  Int           @default(0)
  lastVerificationEmailAt DateTime?     @db.Timestamptz(3)
  // Also in the migration (Prisma cannot express partial indexes): at most ONE live request
  // per correo among registration-v2 rows: UNIQUE (correo) WHERE status <> 'rechazado'
  // AND correo <> '' AND "legalVersion" IS NOT NULL. Legacy rows are outside it on purpose.

  // Every approve/reject request looks this table up by hash; not marked
  // @unique since a genuine sha256 collision is not a correctness
  // guarantee this schema needs to enforce at the DB level (the token
  // itself already has 256 bits of entropy from crypto.randomBytes).
  @@index([approvalTokenHash])
  @@index([emailTokenHash])
  @@index([status, createdAt])
}

// Immutable capital delivered to the business; not revenue or ownership.
model Contribution {
  id                 String   @id @db.Uuid
  contextId          String
  memberId           String   @db.Uuid
  amountMinor        Int
  currency           String   @default("MXN") @db.Char(3)
  occurredAt         DateTime @db.Timestamptz(3)
  note               String?
  createdByMemberId  String   @db.Uuid
  createdByAccountId String   @db.Uuid
  deviceId           String   @db.Uuid
  receivedAt         DateTime @default(now()) @db.Timestamptz(3)
  requestFingerprint String
  creationResponse   Json
  member             Member   @relation("ContributionMember", fields: [memberId], references: [id], onDelete: Restrict)
  createdByMember    Member   @relation("ContributionRecorder", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  device             Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  reversal           ContributionReversal? @relation("OriginalContribution")
  replacedByReversal ContributionReversal? @relation("ReplacementContribution")

  @@index([contextId, occurredAt, id])
  @@index([contextId, memberId, occurredAt, id])
}

// An auditable record correction, never a capital refund.
model ContributionReversal {
  id                        String        @id @db.Uuid
  contextId                 String
  contributionId            String        @unique @db.Uuid
  replacementContributionId String?       @unique @db.Uuid
  reason                    String
  occurredAt                DateTime      @db.Timestamptz(3)
  receivedAt                DateTime      @default(now()) @db.Timestamptz(3)
  createdByMemberId         String        @db.Uuid
  createdByAccountId        String        @db.Uuid
  deviceId                  String        @db.Uuid
  requestFingerprint        String
  creationResponse          Json
  contribution              Contribution  @relation("OriginalContribution", fields: [contributionId], references: [id], onDelete: Restrict)
  replacementContribution   Contribution? @relation("ReplacementContribution", fields: [replacementContributionId], references: [id], onDelete: Restrict)
  createdByMember           Member        @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  device                    Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([contextId, occurredAt, id])
}

// Immutable business expense or inventory purchase fact; never a cash movement
// on its own and never touches stock, lots or product cost.
model Expense {
  id                 String   @id @db.Uuid
  contextId          String
  amountMinor        Int
  currency           String   @default("MXN") @db.Char(3)
  occurredAt         DateTime @db.Timestamptz(3)
  nature             String
  category           String
  description        String
  paidByMemberId     String   @db.Uuid
  fundsSource        String
  createdByMemberId  String   @db.Uuid
  createdByAccountId String   @db.Uuid
  deviceId           String   @db.Uuid
  receivedAt         DateTime @default(now()) @db.Timestamptz(3)
  requestFingerprint String
  creationResponse   Json
  paidByMember       Member   @relation("ExpensePayer", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  createdByMember    Member   @relation("ExpenseRecorder", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  device             Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  reversal           ExpenseReversal? @relation("OriginalExpense")
  replacedByReversal ExpenseReversal? @relation("ReplacementExpense")

  @@index([contextId, occurredAt, id])
  @@index([contextId, paidByMemberId, occurredAt, id])
}

// An auditable record correction, never a refund or income.
model ExpenseReversal {
  id                   String   @id @db.Uuid
  contextId            String
  expenseId            String   @unique @db.Uuid
  replacementExpenseId String?  @unique @db.Uuid
  reason               String
  occurredAt           DateTime @db.Timestamptz(3)
  receivedAt           DateTime @default(now()) @db.Timestamptz(3)
  createdByMemberId    String   @db.Uuid
  createdByAccountId   String   @db.Uuid
  deviceId             String   @db.Uuid
  requestFingerprint   String
  creationResponse     Json
  expense              Expense  @relation("OriginalExpense", fields: [expenseId], references: [id], onDelete: Restrict)
  replacementExpense   Expense? @relation("ReplacementExpense", fields: [replacementExpenseId], references: [id], onDelete: Restrict)
  createdByMember      Member   @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  device               Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([contextId, occurredAt, id])
}

// Immutable work facts, not compensation or inferred sales activity.
model WorkShift {
  id                 String             @id @db.Uuid
  contextId          String
  memberId           String             @db.Uuid
  workDate           DateTime           @db.Date
  minutes            Int?
  note               String?
  createdByMemberId  String             @db.Uuid
  createdByAccountId String             @db.Uuid
  deviceId           String             @db.Uuid
  receivedAt         DateTime           @default(now()) @db.Timestamptz(3)
  requestFingerprint String
  creationResponse   Json
  member             Member             @relation("WorkShiftWorker", fields: [memberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByMember    Member             @relation("WorkShiftRecorder", fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  device             Device             @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount   Account            @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  reversal           WorkShiftReversal? @relation("OriginalWorkShift")
  replacedByReversal WorkShiftReversal? @relation("ReplacementWorkShift")

  @@unique([id, contextId])
  @@index([contextId, workDate, id])
  @@index([contextId, memberId, workDate, id])
}

model WorkShiftReversal {
  id                     String     @id @db.Uuid
  contextId              String
  workShiftId            String     @unique @db.Uuid
  replacementWorkShiftId String?    @unique @db.Uuid
  reason                 String
  occurredAt             DateTime   @db.Timestamptz(3)
  receivedAt             DateTime   @default(now()) @db.Timestamptz(3)
  createdByMemberId      String     @db.Uuid
  createdByAccountId     String     @db.Uuid
  deviceId               String     @db.Uuid
  requestFingerprint     String
  creationResponse       Json
  workShift              WorkShift  @relation("OriginalWorkShift", fields: [workShiftId, contextId], references: [id, contextId], onDelete: Restrict)
  replacementWorkShift   WorkShift? @relation("ReplacementWorkShift", fields: [replacementWorkShiftId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByMember        Member     @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  device                 Device     @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount       Account    @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)

  @@unique([workShiftId, contextId])
  @@unique([replacementWorkShiftId, contextId])
  @@index([contextId, occurredAt, id])
}

// Immutable exact-period planning, not an expense or cash movement.
model FinanceReserve {
  id                 String                  @id @db.Uuid
  contextId          String
  name               String
  amountMinor        Int
  currency           String                  @default("MXN") @db.Char(3)
  periodFrom         DateTime                @db.Date
  periodTo           DateTime                @db.Date
  note               String?
  occurredAt         DateTime                @db.Timestamptz(3)
  receivedAt         DateTime                @default(now()) @db.Timestamptz(3)
  createdByMemberId  String                  @db.Uuid
  createdByAccountId String                  @db.Uuid
  deviceId           String                  @db.Uuid
  requestFingerprint String
  creationResponse   Json
  createdByMember    Member                  @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount   Account                 @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device             Device                  @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)
  reversal           FinanceReserveReversal?

  @@unique([id, contextId])
  @@index([contextId, periodFrom, periodTo, id])
  @@index([contextId, receivedAt, id])
}

// Cancellation audit fact; HTTP reversal behavior is introduced in FR2.
model FinanceReserveReversal {
  id                 String         @id @db.Uuid
  contextId          String
  reserveId          String         @unique @db.Uuid
  reason             String
  occurredAt         DateTime       @db.Timestamptz(3)
  receivedAt         DateTime       @default(now()) @db.Timestamptz(3)
  createdByMemberId  String         @db.Uuid
  createdByAccountId String         @db.Uuid
  deviceId           String         @db.Uuid
  requestFingerprint String
  creationResponse   Json
  reserve            FinanceReserve @relation(fields: [reserveId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByMember    Member         @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount   Account        @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device             Device         @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)

  @@unique([reserveId, contextId])
  @@index([contextId, occurredAt, id])
}

// Phase 5.5: immutable "Acuerdo de reparto" frozen from a distribution simulation.
// Not a payment, withdrawal, debt or obligation. UPDATE/DELETE are rejected by
// database triggers on the agreement, participant and reversal tables.
model DistributionAgreement {
  id                        String                             @id @db.Uuid
  contextId                 String
  folio                     String
  periodFrom                DateTime                           @db.Date
  periodTo                  DateTime                           @db.Date
  requestedAmountMinor      Int
  partnerShareBps           Int
  workShareBps              Int
  workBasis                 String
  partnerMode               String                             @default("EQUAL")
  currency                  String                             @default("MXN") @db.Char(3)
  financialStatus           String
  potentiallyAvailableMinor Int
  partnerPoolMinor          Int
  workPoolMinor             Int
  distributedMinor          Int
  undistributedMinor        Int
  algorithmVersion          Int
  title                     String
  note                      String?
  replacesAgreementId       String?                            @db.Uuid
  createdByMemberId         String                             @db.Uuid
  createdByMemberName       String
  createdByAccountId        String                             @db.Uuid
  deviceId                  String                             @db.Uuid
  occurredAt                DateTime                           @db.Timestamptz(3)
  receivedAt                DateTime                           @default(now()) @db.Timestamptz(3)
  requestFingerprint        String
  snapshotFingerprint       String
  warningsSnapshot          Json
  creationResponse          Json
  createdByMember           Member                             @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount          Account                            @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device                    Device                             @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)
  replacesAgreement         DistributionAgreement?             @relation("AgreementReplacement", fields: [replacesAgreementId, contextId], references: [id, contextId], onDelete: Restrict)
  replacedBy                DistributionAgreement?             @relation("AgreementReplacement")
  participants              DistributionAgreementParticipant[]
  reversal                  DistributionAgreementReversal?
  payments                  DistributionPayment[]

  @@unique([id, contextId])
  @@unique([contextId, folio])
  @@unique([replacesAgreementId, contextId])
  @@index([contextId, receivedAt, id])
  @@index([contextId, periodFrom, periodTo, id])
}

// Frozen per-member line of an agreement: name, role and flags are snapshots.
model DistributionAgreementParticipant {
  agreementId          String                @db.Uuid
  contextId            String
  memberId             String                @db.Uuid
  memberName           String
  role                 String
  isActive             Boolean
  partnerEligible      Boolean
  partnerAmountMinor   Int
  workUnits            Int
  shiftCount           Int
  knownMinutes         Int
  unknownDurationCount Int
  workAmountMinor      Int
  totalMinor           Int
  agreement            DistributionAgreement @relation(fields: [agreementId, contextId], references: [id, contextId], onDelete: Restrict)
  member               Member                @relation(fields: [memberId, contextId], references: [id, contextId], onDelete: Restrict)
  payments             DistributionPayment[]

  @@id([agreementId, memberId])
  @@unique([agreementId, memberId, contextId])
  @@index([contextId, memberId])
}

// Voiding fact; the agreement row itself never changes.
model DistributionAgreementReversal {
  id                 String                @id @db.Uuid
  contextId          String
  agreementId        String                @unique @db.Uuid
  reason             String
  occurredAt         DateTime              @db.Timestamptz(3)
  receivedAt         DateTime              @default(now()) @db.Timestamptz(3)
  createdByMemberId  String                @db.Uuid
  createdByAccountId String                @db.Uuid
  deviceId           String                @db.Uuid
  requestFingerprint String
  creationResponse   Json
  agreement          DistributionAgreement @relation(fields: [agreementId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByMember    Member                @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount   Account               @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device             Device                @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)

  @@unique([agreementId, contextId])
  @@index([contextId, occurredAt, id])
}

// Gapless folio sequence per context and business-time year; allocated with an
// atomic upsert inside the creating transaction. The only mutable agreement table.
model DistributionAgreementCounter {
  contextId  String
  year       Int
  lastNumber Int

  @@id([contextId, year])
}

// Phase 6: a REAL payment recorded against one participant of an agreement.
// La Marchanta does not move money; it records what was actually paid.
// Immutable (database trigger): the only correction is a reversal.
model DistributionPayment {
  id                  String                           @id @db.Uuid
  contextId           String
  agreementId         String                           @db.Uuid
  participantMemberId String                           @db.Uuid
  amountMinor         Int
  currency            String                           @db.Char(3)
  occurredAt          DateTime                         @db.Timestamptz(3)
  note                String?
  createdByMemberId   String                           @db.Uuid
  createdByAccountId  String                           @db.Uuid
  deviceId            String                           @db.Uuid
  receivedAt          DateTime                         @default(now()) @db.Timestamptz(3)
  requestFingerprint  String
  creationResponse    Json
  agreement           DistributionAgreement            @relation(fields: [agreementId, contextId], references: [id, contextId], onDelete: Restrict)
  participant         DistributionAgreementParticipant @relation(fields: [agreementId, participantMemberId, contextId], references: [agreementId, memberId, contextId], onDelete: Restrict)
  createdByMember     Member                           @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount    Account                          @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device              Device                           @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)
  reversal            DistributionPaymentReversal?

  @@unique([id, contextId])
  @@index([contextId, agreementId, participantMemberId])
  @@index([contextId, receivedAt, id])
}

// Voiding fact for one payment; the payment row itself never changes.
model DistributionPaymentReversal {
  id                 String              @id @db.Uuid
  contextId          String
  paymentId          String              @unique @db.Uuid
  reason             String
  occurredAt         DateTime            @db.Timestamptz(3)
  receivedAt         DateTime            @default(now()) @db.Timestamptz(3)
  createdByMemberId  String              @db.Uuid
  createdByAccountId String              @db.Uuid
  deviceId           String              @db.Uuid
  requestFingerprint String
  creationResponse   Json
  payment            DistributionPayment @relation(fields: [paymentId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByMember    Member              @relation(fields: [createdByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  createdByAccount   Account             @relation(fields: [createdByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  device             Device              @relation(fields: [deviceId, contextId], references: [id, contextId], onDelete: Restrict)

  @@unique([paymentId, contextId])
  @@index([contextId, occurredAt, id])
}

// Versioned profit-sharing rules (migration 20261020120000). Once submitted the
// config and its hash never change; DB triggers enforce it. See doc/finance-rules.md.
model FinanceRuleSet {
  id                  String                @id @db.Uuid
  contextId           String
  version             Int
  status              String
  config              Json
  configHash          String
  proposedByMemberId  String                @db.Uuid
  proposedByAccountId String                @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @db.Timestamptz(3)
  submittedAt         DateTime?             @db.Timestamptz(3)
  activatedAt         DateTime?             @db.Timestamptz(3)
  supersededAt        DateTime?             @db.Timestamptz(3)
  withdrawnAt         DateTime?             @db.Timestamptz(3)
  proposedByMember    Member                @relation(fields: [proposedByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  proposedByAccount   Account               @relation(fields: [proposedByAccountId, contextId], references: [id, contextId], onDelete: Restrict)
  approvals           FinanceRuleApproval[]
  reminders           FinanceRuleReminder[]

  @@unique([id, contextId])
  @@unique([contextId, version])
  @@index([contextId, status])
}

model FinanceRuleApproval {
  id                  String         @id @db.Uuid
  contextId           String
  ruleSetId           String         @db.Uuid
  memberId            String         @db.Uuid
  approvedByAccountId String         @db.Uuid
  approvedHash        String
  approvedAt          DateTime       @default(now()) @db.Timestamptz(3)
  // How the approving account was created, frozen with the approval (never recomputed).
  accountOrigin       Json?
  ruleSet             FinanceRuleSet @relation(fields: [ruleSetId, contextId], references: [id, contextId], onDelete: Restrict)
  member              Member         @relation(fields: [memberId, contextId], references: [id, contextId], onDelete: Restrict)
  approvedByAccount   Account        @relation(fields: [approvedByAccountId, contextId], references: [id, contextId], onDelete: Restrict)

  @@unique([ruleSetId, memberId])
  @@index([contextId, ruleSetId])
}

model FinanceRuleReminder {
  id             String         @id @db.Uuid
  contextId      String
  ruleSetId      String         @db.Uuid
  memberId       String         @db.Uuid
  sentByMemberId String         @db.Uuid
  emailSent      Boolean        @default(false)
  sentAt         DateTime       @default(now()) @db.Timestamptz(3)
  ruleSet        FinanceRuleSet @relation(fields: [ruleSetId, contextId], references: [id, contextId], onDelete: Restrict)
  member         Member         @relation("RuleReminderTarget", fields: [memberId, contextId], references: [id, contextId], onDelete: Restrict)
  sentBy         Member         @relation("RuleReminderSender", fields: [sentByMemberId, contextId], references: [id, contextId], onDelete: Restrict)

  @@index([ruleSetId, memberId, sentAt])
  @@index([contextId, memberId, sentAt])
}

// Single-use invitation for an existing socio to create their own login (migration
// 20261021120000). Only the SHA-256 of the token is stored. The public page reaches
// it through two SECURITY DEFINER functions, never through this model.
model AccountInvitation {
  id                String    @id @db.Uuid
  contextId         String
  memberId          String    @db.Uuid
  email             String
  tokenHash         String    @unique @db.Char(64)
  invitedByMemberId String    @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  usedAt            DateTime? @db.Timestamptz(3)
  supersededAt      DateTime? @db.Timestamptz(3)
  accountId         String?   @unique @db.Uuid
  member            Member    @relation("InvitationTarget", fields: [memberId, contextId], references: [id, contextId], onDelete: Restrict)
  invitedBy         Member    @relation("InvitationSender", fields: [invitedByMemberId, contextId], references: [id, contextId], onDelete: Restrict)
  account           Account?  @relation(fields: [accountId, contextId], references: [id, contextId], onDelete: Restrict)

  @@index([contextId, memberId, createdAt])
}
